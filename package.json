{
  "name": "@muthu-printers/api",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "MuthuPrinters pnpm workspace",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#prisma-client": "./src/lib/prisma-client.js"
  },
  "main": "server.js",
  "scripts": {
    "postinstall": "pnpm prisma:generate",
    "dev": "nodemon server.js",
    "dev:all": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "nodemon server.js",
    "dev:web": "pnpm --filter @muthu-printers/web run dev",
    "build": "pnpm -r --if-present run build",
    "test:all": "pnpm -r --if-present run test",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:setup": "pnpm prisma:format && pnpm prisma:validate && pnpm prisma:generate",
    "prisma:migrate:dev": "prisma migrate dev && pnpm prisma:generate",
    "prisma:migrate:deploy": "prisma migrate deploy && pnpm prisma:generate",
    "prisma:migrate:reset": "prisma migrate reset --force && pnpm prisma:generate && pnpm prisma:seed",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:seed:extract": "node src/models/extractSeedData.js",
    "prisma:migrate:squash": "mkdir -p ./src/models/migrations/000000000000_squashed_migrations && prisma migrate diff --from-empty --to-schema ./src/models/schema.prisma --script > ./src/models/migrations/000000000000_squashed_migrations/migration.sql",
    "prisma:migrate:squash:resolve": "prisma migrate resolve --applied 000000000000_squashed_migrations",
    "migrate": "pnpm run prisma:migrate:dev",
    "studio": "pnpm run prisma:studio",
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@etsoo/reactprint": "^1.0.3",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@react-pdf/renderer": "^3.4.4",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "font-awesome-icons": "^1.6.0",
    "http": "^0.0.1-security",
    "joi": "^17.8.3",
    "jquery": "^3.6.3",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "nodemailer": "^6.9.1",
    "num-words": "^1.2.3",
    "number-to-words": "^1.2.4",
    "pm2-windows-startup": "^1.0.3",
    "react-paginate": "^8.2.0",
    "react-to-print": "^2.15.1",
    "socket.io": "^4.6.1",
    "styled-components": "^6.1.12",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1",
    "prisma": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "bcrypt",
      "prisma"
    ]
  }
}
